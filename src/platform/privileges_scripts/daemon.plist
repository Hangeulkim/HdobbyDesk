        <string>/Applications/__APP_NAME__.app/Contents/MacOS/service</string>
        </array>
        <key>RunAtLoad</key>
        <true/>
        <key>WorkingDirectory</key>
        <string>/Applications/__APP_NAME__.app/Contents/MacOS/</string>
    </dict>
</plist>
