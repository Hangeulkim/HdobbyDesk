diff --git a/src/compress.rs b/src/compress.rs
index 761d916..ebe48e7 100644
--- a/src/compress.rs
+++ b/src/compress.rs
@@ -34,0 +35,28 @@ pub fn decompress(data: &[u8]) -> Vec<u8> {
+
+/// Decode untrusted clipboard content with bounded output and decoder memory.
+/// Other consumers keep their existing size policies through `decompress`.
+pub fn decompress_limited(data: &[u8], max_output_size: usize) -> io::Result<Vec<u8>> {
+    use io::Read;
+
+    if data.is_empty() {
+        return Err(io::Error::new(
+            io::ErrorKind::InvalidData,
+            "Missing compressed frame",
+        ));
+    }
+    let read_limit = max_output_size.checked_add(1).ok_or_else(|| {
+        io::Error::new(io::ErrorKind::InvalidInput, "Decompression limit overflow")
+    })?;
+    let mut decoder = zstd::stream::read::Decoder::new(data)?;
+    // Reject a frame requesting a history window larger than 64 MiB.
+    decoder.window_log_max(26)?;
+    let mut output = Vec::new();
+    decoder.take(read_limit as u64).read_to_end(&mut output)?;
+    if output.len() > max_output_size {
+        return Err(io::Error::new(
+            io::ErrorKind::InvalidData,
+            "Decompressed clipboard exceeds the size limit",
+        ));
+    }
+    Ok(output)
+}
