diff --git a/src/direct_tls.rs b/src/direct_tls.rs
new file mode 100644
index 0000000..97298a4
--- /dev/null
+++ b/src/direct_tls.rs
@@ -0,0 +1,400 @@
+//! Direct TLS 1.3 transport. Trust is supplied by the user, never learned from the socket.
+use crate::{bail, tcp::FramedStream, ResultType, Stream};
+use anyhow::Context;
+use base64::{engine::general_purpose::STANDARD, Engine};
+use data_encoding::BASE32_NOPAD;
+use serde_derive::{Deserialize, Serialize};
+use std::{
+    convert::TryFrom,
+    io::Read,
+    net::{IpAddr, SocketAddr},
+    path::Path,
+    sync::Arc,
+};
+use tokio::io::{AsyncRead, AsyncWrite};
+use tokio_rustls::{
+    rustls::{
+        self,
+        pki_types::{CertificateDer, PrivatePkcs8KeyDer, ServerName},
+    },
+    TlsAcceptor, TlsConnector,
+};
+
+// This fixed SAN identifies the protocol; it is not a DNS lookup or a public service.
+const SERVER_NAME: &str = "hdobby.direct";
+const ALPN: &[u8] = b"hdobby-direct/1";
+const MAX_IDENTITY_BYTES: u64 = 16 * 1024;
+const MAX_CERT_BYTES: usize = 4096;
+pub const PEER_CERT_OPTION: &str = "direct-tls-trusted-cert";
+pub const IDENTITY_FILE_OPTION: &str = "direct-tls-identity-file";
+
+pub const LISTEN_IP_OPTION: &str = "direct-listen-ip";
+// The transport authenticates the host only. The application lifts this limit
+// after password/approval authorization succeeds.
+pub const UNAUTHENTICATED_MAX_FRAME: usize = 64 * 1024;
+
+/// Optional interface selection, without DNS or profile access. Invalid input never
+/// falls back to all interfaces or wraps into a different TCP port.
+pub fn listener_endpoint(ip: &str, port: &str) -> ResultType<(Option<IpAddr>, u16)> {
+    let port = if port.is_empty() {
+        21118
+    } else {
+        port.parse::<u16>()
+            .ok()
+            .filter(|p| *p > 0)
+            .ok_or_else(|| anyhow::anyhow!("Direct port must be between 1 and 65535"))?
+    };
+    let ip = if ip.is_empty() {
+        None
+    } else {
+        Some(
+            ip.parse::<IpAddr>()
+                .context("Direct listen address must be an IP address")?,
+        )
+    };
+    Ok((ip, port))
+}
+
+/// Validate and normalize a direct address without DNS or profile access.
+pub fn endpoint(value: &str) -> ResultType<String> {
+    if value != value.trim() || value.chars().any(char::is_whitespace) {
+        bail!("Enter a direct IP address or host:port without spaces");
+    }
+    if let Ok(addr) = value.parse::<SocketAddr>() {
+        if addr.port() == 0 {
+            bail!("Direct port must be between 1 and 65535");
+        }
+        return Ok(addr.to_string());
+    }
+    if let Ok(ip) = value.parse::<IpAddr>() {
+        return Ok(SocketAddr::new(ip, 21118).to_string());
+    }
+    if crate::is_domain_port_str(value) || value.starts_with("localhost:") {
+        if let Some((host, port)) = value.rsplit_once(':') {
+            if port.parse::<u16>().ok().filter(|p| *p > 0).is_some() {
+                return Ok(format!("{}:{}", host.to_ascii_lowercase(), port));
+            }
+        }
+    }
+    bail!("Enter a direct IP address or host:port")
+}
+
+/// Private material is deliberately not Debug/Clone. Persist only in private runtime storage.
+#[derive(Serialize, Deserialize)]
+#[serde(deny_unknown_fields)]
+pub struct Identity {
+    certificate: Vec<u8>,
+    private_key: Vec<u8>,
+}
+
+impl Identity {
+    pub fn load_or_create(path: &Path) -> ResultType<Self> {
+        match std::fs::symlink_metadata(path) {
+            Ok(_) => Self::load(path),
+            Err(err) if err.kind() == std::io::ErrorKind::NotFound => {
+                let identity = Self::generate()?;
+                identity.create_file(path)?;
+                // Return only what was successfully persisted, not the in-memory proposal.
+                Self::load(path)
+            }
+            Err(_) => bail!("Cannot inspect direct TLS identity storage"),
+        }
+    }
+
+    /// Move an existing identity to a durable location without rotating it.
+    ///
+    /// The destination always wins. A present but invalid legacy file is an
+    /// error: silently replacing it would invalidate every paired device.
+    pub fn load_or_create_migrating(path: &Path, legacy_paths: &[&Path]) -> ResultType<Self> {
+        match std::fs::symlink_metadata(path) {
+            Ok(_) => return Self::load(path),
+            Err(err) if err.kind() == std::io::ErrorKind::NotFound => {}
+            Err(_) => bail!("Cannot inspect direct TLS identity storage"),
+        }
+
+        for legacy_path in legacy_paths {
+            if *legacy_path == path {
+                continue;
+            }
+            match std::fs::symlink_metadata(legacy_path) {
+                Ok(_) => {
+                    let identity = Self::load(legacy_path)
+                        .context("Cannot migrate the existing direct TLS identity")?;
+                    if let Err(err) = identity.create_file(path) {
+                        if path.exists() {
+                            return Self::load(path);
+                        }
+                        return Err(err);
+                    }
+                    return Self::load(path);
+                }
+                Err(err) if err.kind() == std::io::ErrorKind::NotFound => continue,
+                Err(_) => bail!("Cannot inspect legacy direct TLS identity storage"),
+            }
+        }
+
+        Self::load_or_create(path)
+    }
+
+    pub fn generate() -> ResultType<Self> {
+        let rcgen::CertifiedKey { cert, key_pair } =
+            rcgen::generate_simple_self_signed(vec![SERVER_NAME.to_owned()])?;
+        Ok(Self {
+            certificate: cert.der().to_vec(),
+            private_key: key_pair.serialize_der(),
+        })
+    }
+
+    /// Public pairing material only. Obtain it from the host through a trusted channel.
+    pub fn pairing_code(&self) -> String {
+        let encoded = BASE32_NOPAD.encode(&self.certificate);
+        let grouped = encoded
+            .as_bytes()
+            .chunks(5)
+            .map(|chunk| std::str::from_utf8(chunk).unwrap_or_default())
+            .collect::<Vec<_>>()
+            .join("-");
+        format!("hdobby2:{grouped}")
+    }
+
+    pub fn load(path: &Path) -> ResultType<Self> {
+        let mut options = std::fs::OpenOptions::new();
+        options.read(true);
+        #[cfg(unix)]
+        {
+            use std::os::unix::fs::OpenOptionsExt;
+            // Validate the opened descriptor, not an earlier path lookup. A FIFO
+            // must also fail promptly instead of blocking startup indefinitely.
+            options.custom_flags(libc::O_NOFOLLOW | libc::O_NONBLOCK);
+        }
+        let file = options
+            .open(path)
+            .context("Cannot open direct TLS identity")?;
+        let metadata = file
+            .metadata()
+            .context("Cannot inspect direct TLS identity")?;
+        if !metadata.is_file() {
+            bail!("Direct TLS identity must be a regular file");
+        }
+        #[cfg(unix)]
+        {
+            use std::os::unix::fs::MetadataExt;
+            if metadata.mode() & 0o077 != 0 || metadata.nlink() != 1 {
+                bail!("Direct TLS identity must be private (mode 0600) with no hard links");
+            }
+        }
+        let mut data = Vec::new();
+        file.take(MAX_IDENTITY_BYTES + 1).read_to_end(&mut data)?;
+        if data.len() as u64 > MAX_IDENTITY_BYTES {
+            bail!("Direct TLS identity is too large");
+        }
+        let identity: Self =
+            serde_json::from_slice(&data).context("Invalid direct TLS identity file")?;
+        identity.server_config()?;
+        Ok(identity)
+    }
+
+    /// Explicit creation only; an existing identity is never overwritten or rotated silently.
+    pub fn create_file(&self, path: &Path) -> ResultType<()> {
+        self.server_config()?;
+        let mut options = std::fs::OpenOptions::new();
+        options.write(true).create_new(true);
+        #[cfg(unix)]
+        {
+            use std::os::unix::fs::OpenOptionsExt;
+            options.mode(0o600);
+        }
+        let mut file = options
+            .open(path)
+            .context("Cannot create direct TLS identity")?;
+        use std::io::Write;
+        file.write_all(&serde_json::to_vec(self)?)?;
+        file.sync_all()?;
+        Ok(())
+    }
+
+    pub fn server_config(&self) -> ResultType<Arc<rustls::ServerConfig>> {
+        if self.certificate.is_empty()
+            || self.certificate.len() > MAX_CERT_BYTES
+            || self.private_key.is_empty()
+            || self.private_key.len() > MAX_CERT_BYTES
+        {
+            bail!("Invalid direct TLS identity");
+        }
+        let mut config = rustls::ServerConfig::builder_with_provider(Arc::new(
+            rustls::crypto::ring::default_provider(),
+        ))
+        .with_protocol_versions(&[&rustls::version::TLS13])?
+        .with_no_client_auth()
+        .with_single_cert(
+            vec![CertificateDer::from(self.certificate.clone())],
+            PrivatePkcs8KeyDer::from(self.private_key.clone()).into(),
+        )?;
+        config.alpn_protocols = vec![ALPN.to_vec()];
+        // Every connection reauthenticates its certificate. No 0-RTT/replayable input.
+        config.max_early_data_size = 0;
+        config.send_tls13_tickets = 0;
+        Ok(Arc::new(config))
+    }
+}
+
+/// No default roots, OS roots, network fetches or certificate-verification bypass.
+pub struct PeerTrust {
+    certificate: CertificateDer<'static>,
+    config: Arc<rustls::ClientConfig>,
+}
+
+impl PeerTrust {
+    pub fn fingerprint(&self) -> String {
+        use sha2::{Digest, Sha256};
+        Sha256::digest(self.certificate.as_ref())
+            .chunks(4)
+            .map(|part| part.iter().map(|b| format!("{b:02X}")).collect::<String>())
+            .collect::<Vec<_>>()
+            .join(" ")
+    }
+
+    pub fn from_pairing_code(code: &str) -> ResultType<Self> {
+        let code = code.trim();
+        if code.is_empty() || code.len() > MAX_CERT_BYTES * 3 {
+            bail!("Invalid direct TLS pairing code");
+        }
+        let bytes = if let Some(encoded) = code.strip_prefix("hdobby2:") {
+            let normalized = encoded
+                .bytes()
+                .filter(|byte| *byte != b'-' && !byte.is_ascii_whitespace())
+                .map(|byte| byte.to_ascii_uppercase())
+                .collect::<Vec<_>>();
+            if normalized.is_empty() || normalized.len() > MAX_CERT_BYTES * 2 {
+                bail!("Invalid direct TLS pairing code");
+            }
+            BASE32_NOPAD
+                .decode(&normalized)
+                .context("Invalid direct TLS pairing code")?
+        } else if let Some(encoded) = code.strip_prefix("hdobby1:") {
+            if encoded.is_empty() || encoded.len() > MAX_CERT_BYTES * 2 {
+                bail!("Invalid direct TLS pairing code");
+            }
+            STANDARD
+                .decode(encoded)
+                .context("Invalid direct TLS pairing code")?
+        } else {
+            bail!("Pair the host's direct TLS certificate before connecting");
+        };
+        if bytes.len() > MAX_CERT_BYTES {
+            bail!("Invalid direct TLS pairing certificate");
+        }
+        let certificate = CertificateDer::from(bytes);
+        let mut roots = rustls::RootCertStore::empty();
+        roots
+            .add(certificate.clone())
+            .context("Invalid direct TLS pairing certificate")?;
+        let mut config = rustls::ClientConfig::builder_with_provider(Arc::new(
+            rustls::crypto::ring::default_provider(),
+        ))
+        .with_protocol_versions(&[&rustls::version::TLS13])?
+        .with_root_certificates(roots)
+        .with_no_client_auth();
+        config.enable_sni = false;
+        config.alpn_protocols = vec![ALPN.to_vec()];
+        config.enable_early_data = false;
+        config.resumption = rustls::client::Resumption::disabled();
+        Ok(Self {
+            certificate,
+            config: Arc::new(config),
+        })
+    }
+}
+
+/// Direct TCP only: does not consult proxy, ID, relay, discovery or previous endpoints.
+pub async fn connect(endpoint: &str, trust: PeerTrust, timeout_ms: u64) -> ResultType<Stream> {
+    let socket = crate::timeout(timeout_ms, tokio::net::TcpStream::connect(endpoint))
+        .await
+        .context("Direct TCP connection timed out")??;
+    socket.set_nodelay(true)?;
+    let address = socket.local_addr()?;
+    connect_stream(socket, address, trust, timeout_ms).await
+}
+
+// Use typed causes rather than error text: an EOF/reset during negotiation is
+// not evidence that the host certificate was rejected. Keep diagnostic values
+// in the error chain, never in the user-facing message.
+fn client_handshake_error(error: std::io::Error) -> anyhow::Error {
+    use rustls::{CertificateError, Error as TlsError};
+    use std::io::ErrorKind;
+
+    let message = match error.get_ref().and_then(|e| e.downcast_ref::<TlsError>()) {
+        Some(TlsError::InvalidCertificate(
+            CertificateError::Expired | CertificateError::ExpiredContext { .. },
+        )) => "Direct TLS certificate expired",
+        Some(TlsError::InvalidCertificate(
+            CertificateError::NotValidYet | CertificateError::NotValidYetContext { .. },
+        )) => "Direct TLS certificate not yet valid",
+        Some(TlsError::InvalidCertificate(_)) => "Direct TLS certificate rejected",
+        Some(_) => "Direct TLS protocol negotiation failed",
+        None => match error.kind() {
+            ErrorKind::UnexpectedEof
+            | ErrorKind::ConnectionReset
+            | ErrorKind::ConnectionAborted
+            | ErrorKind::BrokenPipe => "Direct TLS connection closed during handshake",
+            ErrorKind::TimedOut | ErrorKind::WouldBlock => "Direct TLS handshake timed out",
+            _ => "Direct TLS connection failed during handshake",
+        },
+    };
+    anyhow::Error::new(error).context(message)
+}
+
+pub async fn connect_stream<S>(
+    socket: S,
+    address: SocketAddr,
+    trust: PeerTrust,
+    timeout_ms: u64,
+) -> ResultType<Stream>
+where
+    S: AsyncRead + AsyncWrite + Unpin + Send + Sync + 'static,
+{
+    let connector = TlsConnector::from(trust.config);
+    let stream = crate::timeout(
+        timeout_ms,
+        connector.connect(ServerName::try_from(SERVER_NAME)?, socket),
+    )
+    .await
+    .context("Direct TLS handshake timed out")?
+    .map_err(client_handshake_error)?;
+    let session = stream.get_ref().1;
+    if session.peer_certificates().and_then(|chain| chain.first()) != Some(&trust.certificate)
+        || session.alpn_protocol() != Some(ALPN)
+        || session.protocol_version() != Some(rustls::ProtocolVersion::TLSv1_3)
+    {
+        bail!("Direct TLS peer or protocol does not match the pairing");
+    }
+    Ok(Stream::DirectTls(FramedStream::from(stream, address)))
+}
+
+pub async fn accept_stream<S>(
+    socket: S,
+    address: SocketAddr,
+    config: Arc<rustls::ServerConfig>,
+    timeout_ms: u64,
+) -> ResultType<Stream>
+where
+    S: AsyncRead + AsyncWrite + Unpin + Send + Sync + 'static,
+{
+    let acceptor = TlsAcceptor::from(config);
+    let stream = crate::timeout(timeout_ms, acceptor.accept(socket))
+        .await
+        .context("Direct TLS handshake timed out")?
+        .context("Direct TLS handshake rejected; no plaintext fallback")?;
+    let session = stream.get_ref().1;
+    if session.alpn_protocol() != Some(ALPN)
+        || session.protocol_version() != Some(rustls::ProtocolVersion::TLSv1_3)
+    {
+        bail!("Direct TLS protocol mismatch");
+    }
+    let mut framed = FramedStream::from(stream, address);
+    framed
+        .0
+        .codec_mut()
+        .set_max_packet_length(UNAUTHENTICATED_MAX_FRAME);
+    Ok(Stream::DirectTls(framed))
+}
diff --git a/src/private_network.rs b/src/private_network.rs
new file mode 100644
index 0000000..b7e2a6a
--- /dev/null
+++ b/src/private_network.rs
@@ -0,0 +1,180 @@
+//! Endpoint selection without discovery, cached defaults, or public services.
+//! This module does no DNS lookup and does not determine who operates a host.
+
+use std::net::IpAddr;
+
+fn authority(value: &str) -> Option<(String, Option<u16>)> {
+    let value = value.trim();
+    if value.is_empty() || !value.is_ascii() || value.chars().any(char::is_whitespace) {
+        return None;
+    }
+    let value = if let Some((scheme, rest)) = value.split_once("://") {
+        if !matches!(scheme, "http" | "https") {
+            return None;
+        }
+        rest.split('/').next()?
+    } else {
+        value
+    };
+    if value.contains(['@', '\\', '%', '?', '#', '/']) {
+        return None;
+    }
+    let (host, port) = if let Some(rest) = value.strip_prefix('[') {
+        let (host, rest) = rest.split_once(']')?;
+        host.parse::<std::net::Ipv6Addr>().ok()?;
+        let port = if rest.is_empty() {
+            None
+        } else {
+            Some(rest.strip_prefix(':')?)
+        };
+        (host, port)
+    } else if value.parse::<IpAddr>().is_ok() {
+        (value, None)
+    } else if let Some((host, port)) = value.split_once(':') {
+        (host, Some(port))
+    } else {
+        (value, None)
+    };
+    let host = host.trim_end_matches('.').to_ascii_lowercase();
+    if host.is_empty() {
+        return None;
+    }
+    let host = if let Ok(ip) = host.parse::<IpAddr>() {
+        ip.to_string()
+    } else {
+        if !host.split('.').all(|label| {
+            !label.is_empty()
+                && label.len() <= 63
+                && !label.starts_with('-')
+                && !label.ends_with('-')
+                && label
+                    .bytes()
+                    .all(|b| b.is_ascii_alphanumeric() || b == b'-')
+        }) {
+            return None;
+        }
+        host
+    };
+    let port = match port {
+        Some(p) => {
+            let p = p.parse::<u16>().ok()?;
+            if p == 0 {
+                return None;
+            }
+            Some(p)
+        }
+        None => None,
+    };
+    Some((host, port))
+}
+
+/// Validate an explicitly supplied endpoint. Never returns a default.
+pub fn explicit_endpoint(value: &str) -> Option<String> {
+    let (host, _) = authority(value)?;
+    if host == "rustdesk.com" || host.ends_with(".rustdesk.com") || host == "public" {
+        return None;
+    }
+    Some(value.trim().to_owned())
+}
+
+/// Only explicit options participate. A rejected higher-priority value fails closed.
+pub fn rendezvous_endpoint(values: &[String]) -> Option<String> {
+    let value = values.iter().find(|v| !v.trim().is_empty())?;
+    if value.contains("://") {
+        return None;
+    }
+    explicit_endpoint(value)
+}
+
+/// Compare the advertised relay with the user's separately configured relay.
+/// DNS aliases and redirects are deliberately not resolved or followed here.
+pub fn relay_allowed(advertised: &str, configured: &str, default_port: u16) -> bool {
+    if advertised.contains("://")
+        || configured.contains("://")
+        || explicit_endpoint(advertised).is_none()
+        || explicit_endpoint(configured).is_none()
+    {
+        return false;
+    }
+    match (authority(advertised), authority(configured)) {
+        (Some((a, ap)), Some((b, bp))) => {
+            a == b && ap.unwrap_or(default_port) == bp.unwrap_or(default_port)
+        }
+        _ => false,
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn no_default_or_cached_server() {
+        assert_eq!(rendezvous_endpoint(&[]), None);
+        assert_eq!(rendezvous_endpoint(&[String::new(), " ".into()]), None);
+        assert_eq!(
+            rendezvous_endpoint(&["id.example:21116".into()]),
+            Some("id.example:21116".into())
+        );
+        assert_eq!(
+            rendezvous_endpoint(&["rs-ny.rustdesk.com".into(), "id.example".into()]),
+            None
+        );
+    }
+
+    #[test]
+    fn vendor_and_ambiguous_endpoints_are_rejected() {
+        for value in [
+            "public",
+            "rs-ny.rustdesk.com:21116",
+            "HTTPS://admin.rustdesk.com",
+            "https://ADMIN.RUSTDESK.COM.:21114/api",
+            "id.example@rustdesk.com",
+            "id.example\\@rustdesk.com",
+            "https://%72ustdesk.com",
+            "id.example:0",
+            "id.example:99999",
+            "id.example:invalid",
+            "",
+        ] {
+            assert!(
+                explicit_endpoint(value).is_none(),
+                "rejected endpoint was accepted"
+            );
+        }
+        assert!(explicit_endpoint("https://api.example:21114").is_some());
+        assert!(explicit_endpoint("https://rustdesk.com.example").is_some());
+    }
+
+    #[test]
+    fn relay_requires_explicit_exact_host_and_port() {
+        assert!(!relay_allowed("relay.example", "", 21117));
+        assert!(!relay_allowed("other.example", "relay.example", 21117));
+        assert!(!relay_allowed(
+            "relay.example:21118",
+            "relay.example",
+            21117
+        ));
+        assert!(!relay_allowed(
+            "rs-ny.rustdesk.com",
+            "rs-ny.rustdesk.com",
+            21117
+        ));
+        assert!(relay_allowed(
+            "Relay.Example.:21117",
+            "relay.example",
+            21117
+        ));
+        assert!(relay_allowed("[::1]:21117", "::1", 21117));
+        assert!(relay_allowed(
+            "[2001:db8::1]:21117",
+            "2001:db8:0:0::1",
+            21117
+        ));
+        assert!(!relay_allowed(
+            "https://relay.example",
+            "relay.example",
+            21117
+        ));
+    }
+}
