new file mode 100644
index 0000000..e5826a0
--- /dev/null
+++ b/src/view_style.rs
@@ -0,0 +1,58 @@
+use std::collections::HashMap;
+
+pub(crate) const HDOBBY_ADAPTIVE_VIEW_MIGRATION: &str = "hdobby-adaptive-view-v1";
+
+pub(crate) fn migrate_legacy_desktop_view_style(
+    view_style: &mut String,
+    ui_flutter: &mut HashMap<String, String>,
+) -> bool {
+    if ui_flutter
+        .get(HDOBBY_ADAPTIVE_VIEW_MIGRATION)
+        .map(|value| value == "Y")
+        .unwrap_or(false)
+    {
+        return false;
+    }
+
+    // Older desktop builds stored their 1:1 default as an explicit peer
+    // preference. Migrate it once so resizing the client window scales the
+    // canvas. A later explicit choice of 1:1 remains untouched because the
+    // marker is already present. This changes only client-side rendering;
+    // the host display resolution is never changed here.
+    if view_style == "original" {
+        *view_style = "adaptive".to_owned();
+    }
+    ui_flutter.insert(HDOBBY_ADAPTIVE_VIEW_MIGRATION.to_owned(), "Y".to_owned());
+    true
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn legacy_original_migrates_once() {
+        let mut style = "original".to_owned();
+        let mut ui = HashMap::new();
+
+        assert!(migrate_legacy_desktop_view_style(&mut style, &mut ui));
+        assert_eq!(style, "adaptive");
+
+        style = "original".to_owned();
+        assert!(!migrate_legacy_desktop_view_style(&mut style, &mut ui));
+        assert_eq!(style, "original");
+    }
+
+    #[test]
+    fn existing_adaptive_style_is_marked_without_change() {
+        let mut style = "adaptive".to_owned();
+        let mut ui = HashMap::new();
+
+        assert!(migrate_legacy_desktop_view_style(&mut style, &mut ui));
+        assert_eq!(style, "adaptive");
+        assert_eq!(
+            ui.get(HDOBBY_ADAPTIVE_VIEW_MIGRATION).map(String::as_str),
+            Some("Y")
+        );
+    }
+}
